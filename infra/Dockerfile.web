# Build the SPA, then serve it with nginx (which also proxies /api to the api service). The bundle is
# the same on every CPU, so a multi-arch build compiles it once on the build machine's platform.
FROM --platform=$BUILDPLATFORM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@11.1.2 --activate
WORKDIR /app
COPY . .
# Files keep their mode from the checkout, and Vite copies `public/` as is: under umask 077 they are
# 0600 and the non-root nginx below could not read them. Same for the config (#64).
RUN pnpm install --frozen-lockfile && pnpm --filter @corkspace/web build \
    && chmod -R a+rX apps/web/dist

# The unprivileged nginx image runs master and workers as user `nginx` (uid 101), never as root, so
# it listens on 8080 instead of 80.
FROM nginxinc/nginx-unprivileged:alpine
COPY --chmod=644 infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 infra/nginx-real-ip.sh /docker-entrypoint.d/15-real-ip.sh
# Writes conf.d/demo.inc at start: empty, or the noindex rules when DEMO_MODE=on (docs/demo.md).
COPY --chmod=755 infra/web-demo.sh /docker-entrypoint.d/40-corkspace-demo.sh
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
