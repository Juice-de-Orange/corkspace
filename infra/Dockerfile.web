# Build the SPA, then serve it with nginx (which also proxies /api to the api service).
FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@11.1.2 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @corkspace/web build

# The unprivileged nginx image runs master and workers as user `nginx` (uid 101), never as root, so
# it listens on 8080 instead of 80.
FROM nginxinc/nginx-unprivileged:alpine
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
# Writes conf.d/demo.inc at start: empty, or the noindex rules when DEMO_MODE=on (docs/demo.md).
COPY --chmod=755 infra/web-demo.sh /docker-entrypoint.d/40-corkspace-demo.sh
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
