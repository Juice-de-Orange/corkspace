{
  "name": "corkspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip",
    "check:focused": "node scripts/check-focused-tests.mjs",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:perf": "turbo run test:perf",
    "verify": "node scripts/check-focused-tests.mjs && biome check . && knip && turbo run typecheck test:unit test:integration build",
    "verify:security": "pnpm audit --audit-level=high",
    "verify:full": "pnpm run verify && pnpm run verify:security && turbo run test:e2e test:perf",
    "db:generate": "pnpm --filter @corkspace/db run db:generate",
    "db:migrate": "pnpm --filter @corkspace/db run db:migrate",
    "db:seed-demo": "pnpm --filter @corkspace/api run seed:demo"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "knip": "^6.24.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
