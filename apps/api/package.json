{
  "name": "@corkspace/api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "seed:demo": "tsx src/seed/demo-cli.ts",
    "build": "tsup src/index.ts --format esm --target node22 --clean",
    "test:integration": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@node-rs/argon2": "^2.0.2",
    "@corkspace/db": "workspace:*",
    "@corkspace/shared": "workspace:*",
    "better-auth": "^1.2.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.5",
    "tsup": "^8.3.5",
    "vitest": "^3.0.5"
  }
}
