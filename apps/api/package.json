{
  "name": "@corkspace/api",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "seed:demo": "tsx src/seed/demo-cli.ts",
    "demo:reset": "tsx src/demo/reset-cli.ts",
    "build": "tsup src/index.ts --format esm --target node22 --clean",
    "test:integration": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@node-rs/argon2": "^2.2.2",
    "@corkspace/db": "workspace:*",
    "@corkspace/shared": "workspace:*",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
