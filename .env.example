# Copy to .env and fill in. NEVER commit .env. All keys below are required unless noted.

# --- Core ---
NODE_ENV=production
LOG_LEVEL=info

# --- Postgres (compose) ---
POSTGRES_USER=corkspace
# Required: compose refuses to start without it (no fallback password).
POSTGRES_PASSWORD=
POSTGRES_DB=corkspace
# Only for running api/worker OUTSIDE compose (e.g. local dev against your own Postgres).
# Inside compose this is derived from POSTGRES_* against the host `db`.
DATABASE_URL=

# --- Better Auth ---
# At least 32 random characters, e.g. `openssl rand -base64 48`.
BETTER_AUTH_SECRET=
# The public URL of your instance (the address users type).
BETTER_AUTH_URL=https://corkspace.example.com
AUTH_TRUSTED_ORIGINS=https://corkspace.example.com

# --- Admin seed (created directly on first start; login works without e-mail) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# --- API / web ---
API_PORT=3000
WEB_PORT=8080
WEB_ORIGIN=https://corkspace.example.com
ASSET_DIR=/data/assets

# --- SMTP (optional, reserved) ---
# Parsed at start-up but not used yet: Corkspace sends no mail today (invites and password
# resets happen in the admin area). Leave empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
