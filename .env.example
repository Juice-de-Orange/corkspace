# Copy to .env and fill in. NEVER commit .env. All keys below are required unless noted.

# --- Core ---
NODE_ENV=production
LOG_LEVEL=info

# --- Postgres (compose) ---
POSTGRES_USER=corkspace
# Required: compose refuses to start without it (no fallback password).
POSTGRES_PASSWORD=
POSTGRES_DB=corkspace
# Only for running api/worker OUTSIDE compose (e.g. local dev against your own Postgres).
# Inside compose this is derived from POSTGRES_* against the host `db`.
DATABASE_URL=

# --- Better Auth ---
# At least 32 random characters, e.g. `openssl rand -base64 48`.
BETTER_AUTH_SECRET=
# The public URL of your instance (the address users type).
BETTER_AUTH_URL=https://corkspace.example.com
AUTH_TRUSTED_ORIGINS=https://corkspace.example.com

# --- Admin seed (created directly on first start; login works without e-mail) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# --- Branding (optional) ---
# Name shown in the header, on the sign-in page and in the browser tab; default Corkspace.
# Quote a value with spaces (BRAND_NAME="Family pinboard"): the backup scripts source this file.
BRAND_NAME=Corkspace

# --- Client address behind a proxy (optional, read by the web container) ---
# The sign-in rate limit is kept per client address. nginx in the web container takes it from
# REAL_IP_HEADER, but only when the connection comes from TRUSTED_PROXIES (addresses/CIDRs, space or
# comma separated; "none" trusts nobody). Empty = X-Forwarded-For from loopback and private ranges,
# which covers a reverse proxy on the same host and a tunnel container. Behind a Cloudflare Tunnel
# use REAL_IP_HEADER=CF-Connecting-IP.
TRUSTED_PROXIES=
REAL_IP_HEADER=

# --- API / web ---
API_PORT=3000
WEB_PORT=8080
WEB_ORIGIN=https://corkspace.example.com
ASSET_DIR=/data/assets

# --- SMTP (optional, reserved) ---
# Parsed at start-up but not used yet: Corkspace sends no mail today (no password-reset mail,
# no invitation or feedback notices; see "Known limitations" in the README). Leave empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
